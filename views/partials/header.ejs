<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="A full-stack blog application built with Node.js, Express and MongoDB.">
  <title><%= title ? `${title} | BlogSpace` : "BlogSpace" %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<header class="site-header">
  <a class="brand" href="/blogs"><span class="brand-mark">B</span> BlogSpace</a>
  <nav class="nav">
    <a href="/blogs">Explore</a>
    <% if (currentUser) { %>
      <a href="/dashboard">Dashboard</a>
      <a href="/profile">Profile</a>
      <form class="inline-form" action="/logout" method="POST"><button class="nav-logout" type="submit">Log out</button></form>
    <% } else { %>
      <a href="/login">Log in</a>
      <a class="button button-small" href="/register">Create account</a>
    <% } %>
  </nav>
</header>
<main class="page-shell">
